{
  "name": "nexus-agile-quiz",
  "version": "1.0.0",
  "description": "Nexus Agile Quiz (敏捷开发问答) example app",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build-web": "cd web/main && npm run build",
    "start-web": "cd web/main && npm run start",
    "serve": "nexus serve --environment development",
    "start": "concurrently \"npm run start-web\" \"npm run serve\"",
    "deploy-only": "nexus deploy",
    "nexus-build": "nexus build only --verbose",
    "deploy": "npm run build-web && nexus deploy",
    "postinstall": "cd web/main && npm install"
  },
  "devDependencies": {
    "@pc-nexus/cli": "^1.0.0-rc.0",
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@pc-nexus/core": "^1.0.0-rc.0",
    "@pc-nexus/manifest": "^1.0.0-rc.0"
  }
}
